<?xml version="1.0" encoding="UTF-8"?>
<robot name="lukebot">
   <!-- Base Chassis Link -->
   <link name="chassis_link">
      <visual>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <geometry>
            <box size="0.42 0.33 0.10"/>
         </geometry>
         <material name="gray">
            <color rgba="0.5 0.5 0.5 1.0"/>
         </material>
      </visual>
      <collision>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <geometry>
            <box size="0.42 0.33 0.10"/>
         </geometry>
      </collision>
      <inertial>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <mass value="8.5" />
         <inertia ixx="0.095" ixy="0" ixz="0" iyx="0" iyy="0.155" iyz="0" izx="0" izy="0" izz="0.235"/>
      </inertial>
   </link>

   <!-- Front Left Mecanum Wheel -->
   <link name="front_left_wheel">
      <visual>
         <origin rpy="1.5708 0 0" xyz="0 0 0" />
         <geometry>
            <cylinder length="0.055" radius="0.050"/>
         </geometry>
         <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
         </material>
      </visual>
      <collision>
         <origin rpy="1.5708 0 0" xyz="0 0 0" />
         <geometry>
            <cylinder length="0.055" radius="0.050"/>
         </geometry>
      </collision>
      <inertial>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <mass value="0.35" />
         <inertia ixx="0.00025" ixy="0" ixz="0" iyx="0" iyy="0.00045" iyz="0" izx="0" izy="0" izz="0.00025"/>
      </inertial>
   </link>

   <!-- Front Right Mecanum Wheel -->
   <link name="front_right_wheel">
      <visual>
         <origin rpy="1.5708 0 0" xyz="0 0 0" />
         <geometry>
            <cylinder length="0.055" radius="0.050"/>
         </geometry>
         <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
         </material>
      </visual>
      <collision>
         <origin rpy="1.5708 0 0" xyz="0 0 0" />
         <geometry>
            <cylinder length="0.055" radius="0.050"/>
         </geometry>
      </collision>
      <inertial>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <mass value="0.35" />
         <inertia ixx="0.00025" ixy="0" ixz="0" iyx="0" iyy="0.00045" iyz="0" izx="0" izy="0" izz="0.00025"/>
      </inertial>
   </link>

   <!-- Rear Left Mecanum Wheel -->
   <link name="rear_left_wheel">
      <visual>
         <origin rpy="1.5708 0 0" xyz="0 0 0" />
         <geometry>
            <cylinder length="0.055" radius="0.050"/>
         </geometry>
         <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
         </material>
      </visual>
      <collision>
         <origin rpy="1.5708 0 0" xyz="0 0 0" />
         <geometry>
            <cylinder length="0.055" radius="0.050"/>
         </geometry>
      </collision>
      <inertial>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <mass value="0.35" />
         <inertia ixx="0.00025" ixy="0" ixz="0" iyx="0" iyy="0.00045" iyz="0" izx="0" izy="0" izz="0.00025"/>
      </inertial>
   </link>

   <!-- Rear Right Mecanum Wheel -->
   <link name="rear_right_wheel">
      <visual>
         <origin rpy="1.5708 0 0" xyz="0 0 0" />
         <geometry>
            <cylinder length="0.055" radius="0.050"/>
         </geometry>
         <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
         </material>
      </visual>
      <collision>
         <origin rpy="1.5708 0 0" xyz="0 0 0" />
         <geometry>
            <cylinder length="0.055" radius="0.050"/>
         </geometry>
      </collision>
      <inertial>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <mass value="0.35" />
         <inertia ixx="0.00025" ixy="0" ixz="0" iyx="0" iyy="0.00045" iyz="0" izx="0" izy="0" izz="0.00025"/>
      </inertial>
   </link>

   <!-- Camera Mount Link -->
   <link name="camera_mount">
      <visual>
         <origin rpy="0 0 0" xyz="0 0 0.025" />
         <geometry>
            <box size="0.05 0.10 0.05"/>
         </geometry>
         <material name="gray">
            <color rgba="0.5 0.5 0.5 1.0"/>
         </material>
      </visual>
      <collision>
         <origin rpy="0 0 0" xyz="0 0 0.025" />
         <geometry>
            <box size="0.05 0.10 0.05"/>
         </geometry>
      </collision>
      <inertial>
         <origin rpy="0 0 0" xyz="0 0 0.025" />
         <mass value="0.15" />
         <inertia ixx="0.00002" ixy="0" ixz="0" iyx="0" iyy="0.00001" iyz="0" izx="0" izy="0" izz="0.00002"/>
      </inertial>
   </link>

   <!-- OAK-D IOT 75 Camera Link -->
   <link name="oak_d_camera">
      <visual>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <geometry>
            <box size="0.034 0.097 0.028"/>
         </geometry>
         <material name="white">
            <color rgba="0.9 0.9 0.9 1.0"/>
         </material>
      </visual>
      <collision>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <geometry>
            <box size="0.034 0.097 0.028"/>
         </geometry>
      </collision>
      <inertial>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <mass value="0.084" />
         <inertia ixx="0.000007" ixy="0" ixz="0" iyx="0" iyy="0.000002" iyz="0" izx="0" izy="0" izz="0.000007"/>
      </inertial>
   </link>

   <!-- Camera Optical Frame (standard ROS convention) -->
   <link name="oak_d_camera_optical"/>

   <!-- IMU Link -->
   <link name="imu_link">
      <inertial>
         <origin rpy="0 0 0" xyz="0 0 0" />
         <mass value="0.01" />
         <inertia ixx="0.000001" ixy="0" ixz="0" iyx="0" iyy="0.000001" iyz="0" izx="0" izy="0" izz="0.000001"/>
      </inertial>
   </link>

   <!-- Joint Definitions -->

   <!-- Front Left Wheel Joint -->
   <joint name="front_left_wheel_joint" type="continuous">
      <origin rpy="0 0 0" xyz="0.15 0.17 -0.05" />
      <axis xyz="0 1 0" />
      <parent link="chassis_link" />
      <child link="front_left_wheel" />
      <dynamics damping="0.1" friction="0.1"/>
   </joint>

   <!-- Front Right Wheel Joint -->
   <joint name="front_right_wheel_joint" type="continuous">
      <origin rpy="0 0 0" xyz="0.15 -0.17 -0.05" />
      <axis xyz="0 1 0" />
      <parent link="chassis_link" />
      <child link="front_right_wheel" />
      <dynamics damping="0.1" friction="0.1"/>
   </joint>

   <!-- Rear Left Wheel Joint -->
   <joint name="rear_left_wheel_joint" type="continuous">
      <origin rpy="0 0 0" xyz="-0.15 0.17 -0.05" />
      <axis xyz="0 1 0" />
      <parent link="chassis_link" />
      <child link="rear_left_wheel" />
      <dynamics damping="0.1" friction="0.1"/>
   </joint>

   <!-- Rear Right Wheel Joint -->
   <joint name="rear_right_wheel_joint" type="continuous">
      <origin rpy="0 0 0" xyz="-0.15 -0.17 -0.05" />
      <axis xyz="0 1 0" />
      <parent link="chassis_link" />
      <child link="rear_right_wheel" />
      <dynamics damping="0.1" friction="0.1"/>
   </joint>

   <!-- Camera Mount Joint -->
   <joint name="camera_mount_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0.21 0 0.05" />
      <parent link="chassis_link" />
      <child link="camera_mount" />
   </joint>

   <!-- Camera Joint -->
   <joint name="camera_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0.025 0 0.04" />
      <parent link="camera_mount" />
      <child link="oak_d_camera" />
   </joint>

   <!-- Camera Optical Joint (ROS convention: x-right, y-down, z-forward) -->
   <joint name="camera_optical_joint" type="fixed">
      <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0" />
      <parent link="oak_d_camera" />
      <child link="oak_d_camera_optical" />
   </joint>

   <!-- IMU Joint -->
   <joint name="imu_joint" type="fixed">
      <origin rpy="0 0 0" xyz="0 0 0.05" />
      <parent link="chassis_link" />
      <child link="imu_link" />
   </joint>

   <!-- Gazebo/Isaac Sim specific tags for mecanum wheels -->
   <gazebo reference="front_left_wheel_joint">
      <provideFeedback>true</provideFeedback>
   </gazebo>

   <gazebo reference="front_right_wheel_joint">
      <provideFeedback>true</provideFeedback>
   </gazebo>

   <gazebo reference="rear_left_wheel_joint">
      <provideFeedback>true</provideFeedback>
   </gazebo>

   <gazebo reference="rear_right_wheel_joint">
      <provideFeedback>true</provideFeedback>
   </gazebo>

</robot>
